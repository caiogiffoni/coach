# AI Running Coach — backend environment variables.
# Copy this file to .env and fill in the values you need.

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------

# FastAPI session / JWT secret. Must be at least 32 bytes for HS256.
# Change to a long random string in production.
SECRET_KEY=dev-secret-change-me-before-using-in-production

# SQLite database URL. The default puts coach.db in backend/data/.
DATABASE_URL=sqlite:///data/coach.db

# Bearer token lifetime, in hours (default: one week).
TOKEN_EXPIRE_HOURS=168

# Root log level for the JSON logs written to stdout.
LOG_LEVEL=INFO

# Login rate limit: failed attempts allowed per client IP within the window.
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900

# -----------------------------------------------------------------------------
# LLM provider (used for workout generation)
# -----------------------------------------------------------------------------

# Provider: "kimi" (default, OpenAI-compatible) or "claude".
LLM_PROVIDER=kimi

# OpenAI-compatible endpoint. Default is Kimi K2.
LLM_BASE_URL=https://api.moonshot.ai/v1

# API key for the provider above. If left empty, generation falls back to the
# deterministic rule-based planner (no external calls).
LLM_API_KEY=

# Model name. Examples: kimi-k2-0905-preview, claude-sonnet-4-20250514
LLM_MODEL=kimi-k2-0905-preview

# Request timeout in seconds.
LLM_TIMEOUT_SECONDS=60

# -----------------------------------------------------------------------------
# Manual uploads (GDPR zip / FIT files)
# -----------------------------------------------------------------------------

# Directory where uploaded files are temporarily stored. Cleaned up per-upload.
UPLOAD_DIR=data/uploads

# Per-file size limit (bytes). Default: 100 MiB.
UPLOAD_MAX_FILE_SIZE_BYTES=104857600

# Max files in a single upload request. Default: 10.
UPLOAD_MAX_FILES_COUNT=10

# Max total uncompressed size for a GDPR zip (bytes). Default: 500 MiB.
UPLOAD_MAX_ZIP_UNCOMPRESSED_BYTES=524288000

# Max compression ratio for zip entries (uncompressed/compressed). Default: 100.
UPLOAD_MAX_ZIP_UNCOMPRESSED_RATIO=100

# -----------------------------------------------------------------------------
# Garmin Connect (unofficial API)
# -----------------------------------------------------------------------------

# Email + password for Garmin Connect. Optional until you use push or auto-sync.
# Leave empty to keep push/sync disabled.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Directory where the garminconnect library caches authentication tokens.
GARMIN_TOKEN_STORE=data/garmin_tokens
